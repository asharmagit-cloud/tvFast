      "id": "d3a14c2d1be4f50e8dc07a91",
      "name": "Delhi",
      "locations": [
        {
          "country": {
            "name": "India",
            "id": "2dc477ac10d6c07b3fe008f6"
          },
          "state": {
            "name": "Delhi",
            "id": "d3a14c2d1be4f50e8dc07a91"
          },
          "region": {
            "name": "Union Territories",
            "id": "3d9b6d251faad57c926b0461"
          }
        }
      ],
      "tagline": "Discover the essence of Delhi",
      "labels": ["Culture", "Heritage", "Nature", "Cuisine", "Festivals"],
      "description": {
        "short": "Delhi is a vibrant part of Union Territories, known for its unique traditions, landscapes, and cultural richness."
      },
      "images": {
        "banner": "/images/default.jpg"
      },
      "greetingText": "Welcome to the state of Delhi",
      "experiences": {
        "Food": [
          {
            "name": "Old Delhi Street Food Trail",
            "type": "Food",
            "images": {
              "banner": "/images/default.jpg"
            },
            "description": {
              "short": "Explore the authentic flavors of Old Delhi through bustling markets and legendary street food vendors.",
              "long": "Immerse yourself in the culinary heritage of Old Delhi with this guided street food trail through Chandni Chowk and surrounding areas. Taste legendary dishes from century-old vendors, including crispy parathas at Paranthe Wali Gali, creamy lassi, spicy chaat, and mouth-watering jalebis. Learn about the history and preparation methods of each dish while navigating the vibrant, narrow lanes filled with aromatic spices and sizzling delicacies."
            }
          }
        ],
        "Historical": [
          {
            "name": "UNESCO Heritage Sites Tour",
            "type": "Historical",
            "images": {
              "banner": "/images/default.jpg"
            },
            "description": {
              "short": "Visit Delhi's three UNESCO World Heritage Sites in one comprehensive tour covering Red Fort, Qutub Minar, and Humayun's Tomb.",
              "long": "Embark on a journey through Delhi's illustrious past with visits to all three UNESCO World Heritage Sites. Begin at the iconic Red Fort, explore the architectural marvel of Qutub Minar - India's tallest brick minaret, and conclude at the magnificent Humayun's Tomb, the precursor to the Taj Mahal. Each site represents a different era of Delhi's rich history, from the Delhi Sultanate to the Mughal Empire. Expert guides bring these monuments to life with captivating stories of emperors, architects, and the civilizations they represented."
            }
          }
        ],
        "Cultural": [
          {
            "name": "Delhi Art and Craft Workshop",
            "type": "Cultural",
            "images": {
              "banner": "/images/default.jpg"
            },
            "description": {
              "short": "Learn traditional Indian art forms like miniature painting, block printing, and pottery from master artisans.",
              "long": "Experience the rich artistic traditions of India through hands-on workshops with skilled artisans. Choose from various crafts including Mughal miniature painting, hand block printing on fabric, pottery making, or traditional mehndi (henna) art. These interactive sessions provide insight into centuries-old techniques passed down through generations. Take home your own handcrafted creation along with a deeper appreciation for India's artistic heritage and the dedication of its craftspeople."
            }
          }
        ]
      }
    },
