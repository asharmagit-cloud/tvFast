s # Example .env for fastTV project
# Copy this file to .env and fill in your MongoDB connection string.

# Use either MONGO_URI or MONGO_URL (the script checks both)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/travhoo

# Example local MongoDB (no auth) pointing to travhoo DB
# MONGO_URI=mongodb://localhost:27017/travhoo

# Notes:
# - Do not commit your real .env with credentials into version control.
# - The script `cityLabels.py` reads MONGO_URI and will connect to the `travhoo` database.

